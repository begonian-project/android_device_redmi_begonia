allow mtk_hal_camera persist_data_file:dir { search };
allow mtk_hal_camera persist_camera_data_file:dir rw_dir_perms;
allow mtk_hal_camera persist_camera_data_file:file create_file_perms;

# Allow the MediaTek camera HAL to search, read, write, and create files inside vendor data directories
allow mtk_hal_camera vendor_data_file:dir create_dir_perms;
allow mtk_hal_camera vendor_data_file:file create_file_perms;

set_prop(mtk_hal_camera, vendor_mi_camera_prop)
set_prop(mtk_hal_camera, system_camera_prop)
get_prop(mtk_hal_camera, system_camera_prop)
set_prop(mtk_hal_camera, vendor_camera_eeprom_prop)
set_prop(mtk_hal_camera, vendor_persist_camera_cal_prop)
hal_client_domain(hal_camera_default, hal_power)
hal_client_domain(hal_camera_default, hal_neuralnetworks)
